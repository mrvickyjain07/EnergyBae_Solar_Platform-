# EnergyBae eBill Scanner — environment variables (names + placeholders only).
# Local dev: copy to .env.local. Vercel: Project → Settings → Environment Variables.
# Never commit real values. Never prefix a secret with VITE_ (those are baked
# into the public browser bundle).

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Gemini key for bill extraction (/api/extract, /api/commercial/extract, /api/enhance-bill).
# Every public visitor's scans spend this key's quota — check it in Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Signs session cookies. There is no sign-in in this app, but the server still
# verifies any cookie it receives. Generate: openssl rand -hex 32
JWT_SECRET="MY_JWT_SIGNING_SECRET"

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Model override (default in src/services/geminiExtraction.ts: gemini-3.1-flash-lite).
GEMINI_MODEL=""
# Second model, tried when GEMINI_MODEL is overloaded (503 "high demand").
# Default: gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=""
# Second key, tried on the main model before switching models.
GEMINI_API_KEY_BACKUP=""

# ── NOT USED by the public scanner ────────────────────────────────────────────
# Supabase + Google OAuth (sign-in, saved bills, Drive import, Sheets export)
# exist in the code but are unreachable here. Leave unset.
# SUPABASE_URL=""
# SUPABASE_SECRET_KEY=""
# VITE_GOOGLE_CLIENT_ID=""
# VITE_GOOGLE_API_KEY=""

# ── Local only ────────────────────────────────────────────────────────────────
PORT=3000
