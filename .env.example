# ── Server-side secrets (never exposed to the browser) ──────────────────────

# GEMINI_API_KEY: Required. Get yours at https://aistudio.google.com/apikey
# Add this in Vercel Dashboard → Settings → Environment Variables
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Client-side build-time variables (VITE_ prefix required) ────────────────
# These are embedded into the frontend bundle at build time.
# They are NOT secret, but should be restricted in Google Cloud Console.

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Used for "Save to Google Sheets" feature.
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# VITE_GOOGLE_API_KEY: API key restricted to Google Picker API
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Used to open the Drive folder picker in the Google Sheets export modal.
VITE_GOOGLE_API_KEY="your_google_picker_api_key"
