{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": ".vercel/output/functions",
    "rootDir": "..",
    "baseUrl": ".."
  },
  "include": ["./**/*.ts", "../src/worksheetModel.ts", "../src/services/**/*.ts", "../src/modules/commercial/**/*.ts"],
  "exclude": ["../node_modules", "../src/**/*.tsx", "../src/components", "../src/contexts", "../src/App.tsx", "../src/main.tsx"]
}
